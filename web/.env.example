# ---------------------------------------------------------------------------
# Copy to web/.env for local development. Vite only exposes variables prefixed
# with VITE_ to the bundle — anything else stays server-side, which is why there
# are no secrets here. Never put a token or a signing key in this file: whatever
# is here is compiled into JavaScript that every visitor can read.
# ---------------------------------------------------------------------------

# Base URL of the API.
#
# Leave BLANK for local development: the Vite dev server proxies /api and
# /socket.io to the backend (see vite.config.ts), so the browser stays
# same-origin and the HttpOnly refresh cookie works without HTTPS.
#
# On Vercel set it to the deployed API origin, e.g. https://api.example.com
# The API must then list the Vercel origin in CORS_ORIGINS and run with
# COOKIE_CROSS_SITE=true, or the browser will refuse to send the refresh cookie.
VITE_API_URL=

# Where the dev proxy forwards to. Only read by vite.config.ts at dev time.
VITE_DEV_API_TARGET=http://127.0.0.1:4000

# Shared password for the seeded demo accounts (server/.env SEED_PASSWORD).
#
# Set this on a review deployment to enable one-click sign-in as each role on
# the login page. It is not a secret in any meaningful sense — the seeded
# accounts exist only in the demo database — but it is read from the
# environment rather than written into the source so that a real deployment
# simply leaves it blank and the shortcut disappears.
VITE_DEMO_PASSWORD=
