# ---------------------------------------------------------------------------
# Optional docker-compose overrides. Copy to `.env` only if you need them.
#
# Application secrets do NOT live here — they live in `server/.env`, which the
# `api` service reads via `env_file`. This file exists solely for the handful of
# values Compose itself interpolates.
# ---------------------------------------------------------------------------

# Host port for the Postgres container. Change this if you already run Postgres
# on 5432 — otherwise the local install shadows the container and connections
# fail with "authentication failed for user velozity".
# Remember to match it in server/.env's DATABASE_URL.
POSTGRES_PORT=5432

# Host port for the API container (`--profile full` only).
API_PORT=4000

# Database credentials. The defaults are fine for local development; change them
# for anything reachable from outside your machine.
POSTGRES_USER=velozity
POSTGRES_PASSWORD=velozity
POSTGRES_DB=velozity
