# ---------------------------------------------------------------------------
# Copy to server/.env and fill in. Never commit the real .env.
#
# Generate each secret separately with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Matches the docker-compose service. Change the credentials for any real deploy.
DATABASE_URL=postgresql://velozity:velozity@localhost:5432/velozity?schema=public

# --- Auth ------------------------------------------------------------------
# Two DIFFERENT secrets, each >= 32 chars. Using one secret for both would let
# an access token be replayed at the refresh endpoint.
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string-aaaaaaaa
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string

# Access tokens are short-lived and held in browser memory only.
ACCESS_TOKEN_TTL=15m
# Refresh tokens live in an HttpOnly cookie and are rotated on every use.
REFRESH_TOKEN_TTL_DAYS=7

COOKIE_NAME=velozity_rt
# Leave blank unless the API and SPA share a parent domain.
COOKIE_DOMAIN=
# `true` when the SPA and API are on different sites (e.g. Vercel + Render):
# the refresh cookie then needs SameSite=None; Secure, which requires HTTPS.
# Keep `false` for local development over http://localhost.
COOKIE_CROSS_SITE=false

# bcrypt work factor. 12 is a good 2026 default; lower it only in tests.
BCRYPT_ROUNDS=12

# --- CORS ------------------------------------------------------------------
# Comma-separated exact origins. Credentialed CORS cannot use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Background jobs -------------------------------------------------------
# Overdue-task sweep. Every 5 minutes by default.
OVERDUE_CRON=*/5 * * * *
ENABLE_SCHEDULER=true

# --- Seed ------------------------------------------------------------------
# Shared password for every seeded demo account.
SEED_PASSWORD=Password123!
# The seed rebuilds the fixture from scratch, so it refuses to run against a
# non-empty database when NODE_ENV=production. Set this to `true` only when you
# genuinely want to delete what is there and re-seed.
SEED_FORCE=false
